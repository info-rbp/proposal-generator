{
  "name": "rbp-proposal-generator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:client": "vite --config vite.public.config.ts",
    "build": "vite build && vite build --config vite.public.config.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "bun test tests",
    "test:browser": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply proposal-generator --local",
    "db:migrate:remote": "wrangler d1 migrations apply proposal-generator --remote",
    "deploy:workers": "wrangler d1 migrations apply proposal-generator --remote && wrangler deploy && env -u WRANGLER_CI_OVERRIDE_NAME -u WRANGLER_CI_MATCH_TAG wrangler deploy --config wrangler.public.jsonc",
    "deploy": "bun run lint && bun run test && bun run build && bun run deploy:workers",
    "deploy:check": "bun run build && wrangler deploy --dry-run && wrangler deploy --config wrangler.public.jsonc --dry-run",
    "deploy:mcp": "wrangler deploy --config wrangler.mcp.jsonc",
    "deploy:mcp:check": "wrangler deploy --config wrangler.mcp.jsonc --dry-run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.5.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.1.0",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.29.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0",
    "@playwright/test": "^1.56.1"
  }
}
